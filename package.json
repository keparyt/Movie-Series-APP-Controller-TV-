{
  "name": "movie-series-app-controller-tv",
  "version": "1.0.0",
  "description": "TV-focused Electron media browser with TMDB discovery and VidKing playback.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "dist": "npm run package",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.kepar.movieapp",
    "productName": "Movie Series TV",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
